<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <BaseIntermediateOutputPath>obj\ProtocolReplay\</BaseIntermediateOutputPath>
    <BaseOutputPath>bin\ProtocolReplay\</BaseOutputPath>
    <IsTestProject>true</IsTestProject>
    <OutputType>Exe</OutputType>
    <UseAppHost>true</UseAppHost>
    <Nullable>enable</Nullable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <AssemblyName>HermesProxy.ProtocolReplay.Tests</AssemblyName>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="**\*.cs" />
    <Compile Include="ProtocolReplay\*.cs" />
    <Compile Include="World\ModernOnlyCompatibilityMatrixTests.cs" />
    <Compile Include="ProtocolReplayTestModuleInitializer.cs" />
    <Content Include="Fixtures\Protocol\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HermesProxy\HermesProxy.csproj" />
    <ProjectReference Include="..\Framework\Framework.csproj" />
  </ItemGroup>
</Project>
